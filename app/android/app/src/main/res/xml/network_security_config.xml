<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere, with one deliberate exception: the local development API.

  `adb reverse tcp:8000 tcp:8000` maps the device's own 127.0.0.1 to the machine
  running `php artisan serve`, and 10.0.2.2 is the emulator's route to its host.
  Nothing else may travel in the clear.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
