<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer draw their own launch screen: the adaptive icon on a
  plain colour. That colour is VouchFlow's navy in light and dark alike, so
  the launch never flashes white before the app's first frame.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vf_window</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/vf_window</item>
    </style>
</resources>
