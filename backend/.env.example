APP_NAME=VouchFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vouchflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@vouchflow.co.tz"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@vouchflow.co.tz"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- VouchFlow ---
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
VOUCHFLOW_TRIAL_DAYS=14
VOUCHFLOW_MAX_UPLOAD_MB=10
PAYMENTS_DRIVER=demo
# Two-step sign-in: every login needs a one-time code after the password.
# Codes go by e-mail (configure MAIL_* above; with MAIL_MAILER=log they are
# written to storage/logs/laravel.log) and by SMS when the account has a phone.
# Set to false only as an emergency switch if mail delivery is down.
VOUCHFLOW_TWO_FACTOR=true
# SMS driver for sign-in codes. Only "log" exists today (writes to the log).
SMS_DRIVER=log

# --- Platform bootstrap ---
SUPER_ADMIN_EMAIL=super@vouchflow.test
SUPER_ADMIN_PASSWORD=Password123!
SEED_DEMO=true

# Front-end origins permitted to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8091

# 24-hour voucher reminders (run by the scheduler: * * * * * php artisan schedule:run)
VOUCHFLOW_REMINDERS=true
VOUCHFLOW_REMINDER_EMAILS=true
