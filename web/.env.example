# Phase 1 runs entirely on the in-browser mock in lib/mock/ — no API, no
# database, no configuration. This file is only needed for Phase 2.
#
# Set to "live" to route lib/api.ts through HTTP instead of the mock. Nothing
# above the transport changes.
NEXT_PUBLIC_API_MODE=mock

# Where the Laravel API lives, once API_MODE is live.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
